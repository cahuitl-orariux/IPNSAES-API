{
	"name": "kesos-ipnsaes-api",
	"version": "2.0.0",
	"description": "Una librería con utilidades e interfaces para scrapear el SAES del poli",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		"./csv2json": {
			"import": "./dist/csv2json.js",
			"require": "./dist/csv2json.js",
			"types": "./dist/csv2json.d.ts"
		},
		"./Materias": {
			"import": "./dist/Materias.js",
			"require": "./dist/Materias.js",
			"types": "./dist/Materias.d.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest",
		"test:run": "vitest run",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest --watch"
	},
	"author": "El Keso",
	"license": "MIT",
	"files": [
		"dist",
		"README.md"
	],
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/papaparse": "^5.3.16",
		"@vitest/ui": "^3.2.4",
		"papaparse": "^5.5.3",
		"typescript": "^5.0.0",
		"vitest": "^3.2.4"
	},
	"packageManager": "pnpm@9.1.2+sha512.127dc83b9ea10c32be65d22a8efb4a65fb952e8fefbdfded39bdc3c97efc32d31b48b00420df2c1187ace28c921c902f0cb5a134a4d032b8b5295cbfa2c681e2"
}
